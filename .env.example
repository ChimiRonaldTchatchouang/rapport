# ==========================================================================
# Variables d'environnement — Plateforme Rapports (Nextiaa)
# Copier ce fichier en .env.local et remplir les valeurs.
# NE JAMAIS committer .env.local ni de vraie clé.
# ==========================================================================

# --- Supabase (Base de données + Authentification) ------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...  # clé "anon public" (côté client, protégée par RLS)

# Clé service_role : accès ADMIN qui BYPASSE la RLS.
# Utilisée uniquement côté serveur pour les opérations Super Admin
# (création de licences, etc.). NE JAMAIS l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Google Gemini (Module 5 — Analyse IA) --------------------------------
GEMINI_API_KEY=

# --- Resend (Module 10 — Notifications & emails entrants) -----------------
RESEND_API_KEY=
# Adresse d'expédition vérifiée dans Resend
RESEND_FROM_EMAIL=rapports@ton-domaine.com
# Token partagé protégeant le webhook d'emails entrants (?token=...)
RESEND_WEBHOOK_SECRET=

# --- CRON (Module 5 — analyse IA agrégée automatique) ---------------------
# Secret protégeant /api/cron/analyses. Sur Vercel, défini automatiquement
# comme Authorization: Bearer <CRON_SECRET> lors des exécutions planifiées.
CRON_SECRET=

# --- Application ----------------------------------------------------------
# URL publique de l'app (utile pour les liens dans les emails / redirections)
NEXT_PUBLIC_APP_URL=http://localhost:3000
